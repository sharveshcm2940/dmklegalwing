# Copy to .env and fill in. Never commit .env.
FLASK_ENV=production
SECRET_KEY=change-me-long-random-string
JWT_SECRET_KEY=change-me-another-long-random-string
# MySQL 8, utf8mb4 (needed for Tamil text)
DATABASE_URL=mysql+pymysql://legalwing:STRONG_PASSWORD@127.0.0.1:3306/dmk_legal_wing?charset=utf8mb4
# Where uploaded images / PDFs are stored (nginx serves /uploads from here)
UPLOAD_DIR=/var/www/dmk-legal-wing/uploads
# Set to true when the site runs on https (it should)
COOKIE_SECURE=true
# Comma separated origins allowed to call the API from another domain. Leave empty if the site and API share one domain.
CORS_ORIGINS=
# First admin account, used by seed.py
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=
